NODE_ENV=app

# Akahu API credentials - see https://developers.akahu.nz
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# Bank gateway (bank-gateway.js / mcp-server.js) - set these to the real Akahu account IDs
# for each allowed alias, from `npm run cli -- list-accounts` output. Left unset, the
# alias is instead resolved by matching the connection/bank name, which only works if
# exactly one connected account matches.
RABOBANK_ACCOUNT_ID=
WESTPAC_ACCOUNT_ID=
