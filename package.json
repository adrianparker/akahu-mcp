    "test:watch": "NODE_ENV=test mocha --watch",
    "coverage": "c8 npm test",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "Adrian Parker",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.9.0",
    "commander": "^11.1.0",
    "console-table-printer": "^2.14.1",
    "dotenv": "^17.2.3",
    "strip-ansi": "^7.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "c8": "^10.1.2",
    "chai": "^6.2.2",
    "mocha": "^10.2.0",
    "sinon": "^17.0.1",
    "eslint": "^9.9.0",
    "globals": "^15.15.0",
    "neostandard": "^0.11.0"
  },
  "c8": {
    "reporter": ["text", "html"],
    "exclude": ["test/**", "eslint.config.js"]
